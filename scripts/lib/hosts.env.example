# Copy this file to scripts/lib/hosts.env (gitignored -- never committed)
# and fill in the real values. scripts/*.sh source hosts.env if present, so
# once this is set up every script that talks to staging/production picks
# it up automatically.
#
# Kept out of the repo because these name real, private infrastructure
# hosts and an SSH port, which must never be committed to a public repo.

BLUELINE_STAGING_HOST="root@example-staging-host"
BLUELINE_STAGING_PORT="22"

BLUELINE_PRODUCTION_HOST="root@example-production-host"
BLUELINE_PRODUCTION_PORT="22"
