{
  "name": "blueline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:css": "wp-scripts lint-style 'assets/src/css/**/*.css'",
    "lint:js": "wp-scripts lint-js 'assets/src/js/**/*.js'",
    "tokens:check": "node tools/check-contrast.mjs",
    "test:js": "node --test",
    "test:browser": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 wp-scripts test-playwright",
    "check": "npm run lint:css && npm run lint:js && npm run test:js && npm run tokens:check && composer test && composer lint",
    "check:oracle": "npm run lint:css && npm run lint:js && npm run test:js && npm run tokens:check && composer test:oracle && composer lint"
  },
  "devDependencies": {
    "@wordpress/scripts": "^34.0.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "serialize-javascript": "7.1.0",
    "adm-zip": "0.6.0",
    "markdownlint-cli": "0.49.1",
    "webpack-dev-server": "6.0.0",
    "copy-webpack-plugin": "14.0.0",
    "lighthouse": "13.4.1",
    "puppeteer-core": "25.8.0",
    "@puppeteer/browsers": "3.2.1",
    "@sentry/node": "10.70.0"
  }
}
