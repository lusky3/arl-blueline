    { "id": "paper-not-text-on-occasion-accent",  "description": "--bl-occasion-accent correctly unusable as paper text (fill-only, like --bl-ice)", "fg": "--bl-paper", "bg": "--bl-occasion-accent", "max": 3.0 },
