
server {


    server_name rookiehockey.ca www.rookiehockey.ca;


    access_log /var/log/nginx/rookiehockey.ca.access.log rt_cache_redis;
    error_log /var/log/nginx/rookiehockey.ca.error.log;


    
    root /var/www/rookiehockey.ca/htdocs;
    

    index index.php index.html index.htm;


    include common/php83.conf;   # TEMP 2026-08-12: srcache crashes nginx 1.30.4
    
    include common/wpcommon-php83.conf;
    include common/locations-wo.conf;
    include /var/www/rookiehockey.ca/conf/nginx/*.conf;

}
